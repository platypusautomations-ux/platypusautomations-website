/privacy.html /privacy 301
/terms.html /terms 301
/voice-agent.html /voice-agent 301
/website-gbp.html /website-gbp 301

# Serve HTML files for clean URLs without redirect (200 = rewrite, not redirect)
/ai-text-screening /ai-text-screening.html 200
